# ============================================================
# AI-improves-itself — configuration
# Copier ce fichier en `.env` à la racine du repo et remplir.
# Sans AUCUNE clé, le serveur démarre en MODE DÉMO (local,
# déterministe) qui montre quand même la boucle d'auto-amélioration.
#
# Les limites et les IDs de modèles ci-dessous ont été vérifiés le
# 2026-09-15 → détails + sources dans docs/FREE-TIERS.md.
# ============================================================

# --- Fournisseurs IA (chaîne de repli, Mistral en priorité) ----------------
# Ordre d'essai : Mistral → Gemini → Groq → OpenRouter → NVIDIA → démo locale.
# Le premier avec une clé est le moteur principal ; si son quota tombe (429),
# le cœur essaie AUTOMATIQUEMENT le suivant avant de basculer en mode démo.
# Chaque moteur mis au repos est re-testé seul, à la fin de SA fenêtre :
#   • 429 « fenêtre glissante » → ~1 min (ou le Retry-After annoncé)
#   • quota journalier          → minuit (heure du Pacifique pour Google, UTC sinon)
#   • quota mensuel (Mistral)   → 1er du mois
#   • modèle retiré / clé morte → 1 h + message disant quoi changer ici
#
# Chaque variable *_MODEL accepte UNE LISTE séparée par des virgules : les
# modèles sont essayés dans l'ordre (utile car les quotas gratuits sont
# souvent séparés par modèle).

# --- Mistral « La Plateforme », mode gratuit (Experiment) ------------------
# Limites réelles (mesurées par la communauté, r/MistralAI, fév. 2026) :
#   • ~1 requête/seconde GLOBALE par clé, quel que soit le modèle
#   • pool « standard » PARTAGÉ (small / large-2512 / codestral / ministral) :
#     50 000 tokens/min + 4 000 000 tokens/mois
#   • mistral-large-2411 a son PROPRE pool : 600 000 tokens / 5 min, 60 req/min
#   • les nombres exacts de ton compte : https://admin.mistral.ai/plateforme/limits
#
# Le défaut du projet essaie le Ministral 8B D'ABORD : même pool que Small 4,
# mais il répond en quelques centaines de tokens au lieu de plusieurs milliers
# → il tient ~10× plus longtemps dans les 50 000 tokens/min. Retour d'usage :
# c'est le modèle gratuit qui passe quand `mistral-small-latest` sort en erreur.
#
# ⚠️ IDs RETIRÉS (appel = erreur, pas un 429 — un repos ne changera rien) :
#   magistral-small-latest / magistral-medium-latest (ligne Magistral retirée
#   le 31/07/2026), mistral-medium-2508 et mistral-medium-2505 (31/08/2026),
#   devstral-2512 (31/07/2026), mistral-small-2506 (31/07/2026),
#   open-mistral-nemo (31/07/2026).
MISTRAL_API_KEY=
# MISTRAL_MODEL=ministral-8b-latest,mistral-small-latest,mistral-large-2411,ministral-3b-latest
# Raisonnement (« reasoning_effort: high » sur Small 4 / Medium 3.5). OFF par
# défaut : les tokens de réflexion comptent dans le quota gratuit → cher.
# MISTRAL_REASONING=0

# --- Google AI Studio (Gemini) — tier gratuit = famille Flash uniquement ----
# 10-15 req/min, 250 000 tokens/min, 1 500 req/jour (Flash), remise à zéro à
# minuit heure du PACIFIQUE. Les modèles Pro ne sont plus gratuits (mai 2026) et
# Google a déjà réduit le tier gratuit sans préavis (déc. 2025). Les prompts du
# tier gratuit peuvent servir à améliorer les produits Google.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash,gemini-3-flash-preview,gemini-2.5-flash-lite

# --- Groq (GroqCloud) — sans carte, le plus simple en secours ---------------
# 30 RPM / 1 000 req/jour / 8 000 tokens/min / 200 000 tokens/JOUR sur
# gpt-oss-120b (qwen3.6-27b : 60 RPM). Le plafond de tokens par jour tombe en
# premier, et les modèles de raisonnement consomment des tokens invisibles.
# ⚠️ llama-3.3-70b-versatile et llama-3.1-8b-instant sont COUPÉS depuis le
#   16/08/2026 (qwen/qwen3-32b et llama-4-scout depuis le 17/07/2026).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b

# --- OpenRouter — modèles `:free` -------------------------------------------
# 20 req/min sur les variantes `:free` + 50 req/JOUR (1 000/jour après un achat
# UNIQUE de 10 $ de crédits, définitif). ⚠️ les tentatives refusées en 429
# comptent dans le quota journalier → ne jamais faire de retry en rafale.
# `openrouter/free` est l'auto-routeur officiel : il choisit un modèle gratuit
# compatible avec la demande (outils, images, JSON) et survit à la rotation du
# catalogue. La capacité gratuite est un pool partagé, saturé aux heures de
# pointe (soirées US, week-ends).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free

# --- NVIDIA NIM (Build) — 5e secours OPTIONNEL ------------------------------
# OpenAI-compatible, sans carte, crédit mensuel offert (~1 000 crédits/mois
# selon les périodes), ~40 req/min. Catalogue et plafonds très volatils :
# vérifier les IDs sur https://build.nvidia.com avant de compter dessus.
NVIDIA_API_KEY=
# NVIDIA_MODEL=openai/gpt-oss-120b,meta/llama-3.3-70b-instruct

# --- Supabase (base de données — phase 2, voir supabase/schema.sql) ---
# Tant que vide, le projet utilise les fichiers JSON locaux de core/data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Base de données : backend actif ----------------------------------------
# auto (défaut) : supabase si configuré → github si configuré → local.
# Forcer un backend : local | github | supabase.
STORE_BACKEND=auto

# --- GitHub comme base de données (repo privé, voir docs/GITHUB-BACKEND.md) --
# Un fichier JSON par collection (data/*.json + les tâches de recherche), lu/
# écrit via l'API Contents. Idéal : repo privé dédié (ex. mon-compte/ai-data-privé).
# Token : https://github.com/settings/personal-access-tokens → « Fine-grained
# token » → repositories : TON repo de données UNIQUEMENT → Contents : Read
# and write. Le token reste dans TON .env (jamais commité, jamais affiché).
GITHUB_TOKEN=
GITHUB_REPO=
# GITHUB_BRANCH=main
# GITHUB_DIR=data
# Emplacement des tâches de recherche dans le repo de données (défaut :
# colab/tasks.json). Les tâches créées par l'IA ou par un humain sont
# synchronisées à cet endroit — le notebook Colab lit ce fichier.
# RESEARCH_TASKS_PATH=colab/tasks.json

# --- Site principal (utilisé par le notebook Colab pour renvoyer les résultats) ---
MAIN_SITE_URL=http://localhost:8000

# --- Vision (analyse d'images) ----------------------------------------------
# Le chat accepte des images (bouton 📎 ou collage) : le moteur Mistral
# `ministral-8b-latest` est multimodal et les décrit. Rien d'autre à
# configurer — les images partent en base64 (max 4 / 2 Mo, aucun stockage).
# Sans clé Mistral, le mode démo explique qu'il ne peut pas voir les images.

# --- Diverse ---
PORT=8000
